+    static var day: Int? {
+        let args = ProcessInfo.processInfo.arguments
+        guard let flag = args.firstIndex(of: "--qa-mimi-day"), args.indices.contains(flag + 1) else { return nil }
+        return Int(args[flag + 1])
+    }
+    /// Day 1 is now (the first report's own cutoff); day N is 21:00 on today + N-1, so the summary shown is that day's 20:00.
+    static var now: Date {
+        guard let day, day > 1 else { return Date() }
+        let calendar = Calendar.current
+        return calendar.date(byAdding: .day, value: day - 1, to: calendar.startOfDay(for: Date()))!.addingTimeInterval(21 * 3_600)
+    }

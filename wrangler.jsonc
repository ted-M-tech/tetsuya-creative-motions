{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "tetsuya-creative-motions",
  "account_id": "76b7441b99478c7d2bb1accbee256299",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/media/*", "/", "/en", "/en/", "/works/*", "/films/*", "/slides/*", "/en/works/*", "/en/films/*", "/en/slides/*"
    ]
  },
  "routes": [
    {
      "pattern": "videos.maepace.com",
      "custom_domain": true
    }
  ],
  "main": "server/media.mjs"
}
